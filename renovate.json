{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "typescript-eslint does not support TypeScript 7 yet",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
